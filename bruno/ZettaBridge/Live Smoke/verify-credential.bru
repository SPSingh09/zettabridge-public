meta {
  name: POST Verify Credential (live smoke)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/credentials/{{credId}}/verify
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Prerequisite: live credential created (Credentials → create-angel / create-dhan / create-mt5 / create-demo with live mode).
  Expect `valid: true` when broker token and IP whitelist are correct.
  On `valid: false`, read `error_code` and `hint` before sending webhooks.
}

tests {
  test("Verify returns result", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.have.property("valid");
  });

  test("Live smoke expects valid credential", function() {
    const data = res.getBody().data;
    if (data.valid !== true) {
      console.log("verify failed:", JSON.stringify(data));
    }
    expect(data.valid).to.equal(true);
  });
}
