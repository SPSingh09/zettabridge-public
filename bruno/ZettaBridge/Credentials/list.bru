meta {
  name: GET List Credentials
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/credentials
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const rows = res.getBody().data;
    if (!Array.isArray(rows)) return;
    const indianBrokers = ["zerodha", "angel", "dhan"];
    const indian = rows.find((c) => indianBrokers.includes(c.broker_type));
    const mt5 = rows.find((c) => c.broker_type === "mt5_cloud");
    if (indian) {
      bru.setVar("credId", indian.id);
      bru.setVar("zerodhaCredId", indian.id);
      console.log("credId saved from list:", indian.id, "(" + indian.broker_type + ")");
    } else if (mt5) {
      bru.setVar("credId", mt5.id);
      bru.setVar("mt5CredId", mt5.id);
      console.log("credId saved from list:", mt5.id, "(mt5_cloud)");
    }
  }
}

docs {
  Returns credential metadata (id, broker_type, account_label, account_mode, exchange, product). Encrypted blobs are never exposed.
  Auto-saves {{credId}} from first Indian broker credential (zerodha/angel/dhan), falling back to mt5_cloud.
}

tests {
  test("List omits credential secrets", function() {
    expect(res.getStatus()).to.equal(200);
    const body = JSON.stringify(res.getBody());
    expect(body).to.not.include("raw_creds");
    expect(body).to.not.include("encrypted_creds");
    expect(body).to.not.include("v1:");
  });

  test("List includes Phase 0 metadata fields", function() {
    const rows = res.getBody().data;
    if (Array.isArray(rows) && rows.length > 0) {
      const row = rows[0];
      expect(row).to.have.property("broker_type");
      expect(row).to.have.property("account_mode");
      expect(row).to.have.property("exchange");
      expect(row).to.have.property("product");
    }
  });
}
