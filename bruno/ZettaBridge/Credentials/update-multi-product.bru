meta {
  name: PUT Update Credential — multi-product
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/v1/credentials/{{credId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "products": ["MIS", "CNC"]
  }
}

docs {
  Pro Plus: update enabled products without rotating credentials.
  Requires Pro Plus plan; stores as comma-separated `product` field server-side.
}

tests {
  test("Updated products", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.products).to.include.members(["MIS", "CNC"]);
    expect(data.products).to.not.include("NRML");
  });
}
