meta {
  name: POST Verify Credential (mt5_cloud)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/credentials/{{mt5CredId}}/verify
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Prerequisite: Credentials → create-mt5.
  MT5 credentials have no `exchange` / `product`; verify checks `auth_token:account_id` format only in mock mode.
}

tests {
  test("MT5 verify valid in mock mode", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.valid).to.equal(true);
    expect(data.broker_type).to.equal("mt5_cloud");
    expect(data.exchange || "").to.equal("");
  });
}
