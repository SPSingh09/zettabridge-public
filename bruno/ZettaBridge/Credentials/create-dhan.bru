meta {
  name: POST Create Credential (dhan)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "broker_type": "dhan",
    "account_label": "Dhan",
    "account_mode": "live",
    "exchange": "NSE",
    "product": "MIS",
    "raw_creds": "client_id:access_token"
  }
}

docs {
  **Live mode:** Dhan static IP whitelist + ~24h token refresh — see `docs/broker-guide.md`.
  Instrument `securityId` resolved via `/v2/instrument/{NSE_EQ|BSE_EQ}` and cached in Redis (`symtoken:dhan:…`).
  Webhook: **create-indian**.
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("dhanCredId", res.getBody().data.id);
    bru.setVar("credId", res.getBody().data.id);
  }
}

tests {
  test("Dhan credential created with exchange and product", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().data;
    expect(data.broker_type).to.equal("dhan");
    expect(data.exchange).to.equal("NSE");
    expect(data.product).to.equal("MIS");
    expect(data).to.not.have.property("raw_creds");
  });
}
