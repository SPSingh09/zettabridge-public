meta {
  name: POST Create Credential (mt5_cloud)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "broker_type": "mt5_cloud",
    "account_label": "MT5 Demo",
    "account_mode": "demo",
    "raw_creds": "auth_token:account_id"
  }
}

docs {
  MT5 MetaApi format: `auth_token:account_id`. No `exchange` or `product`.
  Use with Webhooks → **create** (EURUSD, etc.). Token refresh: `docs/broker-guide.md`.
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("mt5CredId", res.getBody().data.id);
    bru.setVar("credId", res.getBody().data.id);
  }
}

tests {
  test("MT5 credential created without exchange", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().data;
    expect(data.broker_type).to.equal("mt5_cloud");
    expect(data.exchange || "").to.equal("");
    expect(data).to.not.have.property("raw_creds");
  });
}
