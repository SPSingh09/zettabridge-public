meta {
  name: POST Create Credential (live) — blocked on free
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "broker_type": "zerodha",
    "account_label": "Zerodha Live",
    "account_mode": "live",
    "exchange": "NSE",
    "raw_creds": "api_key:access_token"
  }
}

docs {
  Live credentials require **pro** or **pro_plus** plan. Free/paper users get 403.
}

tests {
  test("Free plan returns 403", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("Error response omits submitted secrets", function() {
    const body = JSON.stringify(res.getBody());
    expect(body).to.not.include("api_key:api_secret");
    expect(body).to.not.include("v1:");
  });
}
