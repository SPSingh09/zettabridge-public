meta {
  name: POST Create Credential — multi-product (Pro Plus)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "broker_type": "zerodha",
    "account_label": "Zerodha Pro Plus",
    "account_mode": "live",
    "exchange": "NSE",
    "products": ["MIS", "CNC", "NRML"],
    "market_protection": 2,
    "raw_creds": "api_key:access_token"
  }
}

docs {
  **Pro Plus only** — enables MIS, CNC, and NRML on one broker account.

  Prerequisites:
  1. Admin → PUT Set User Plan — Pro Plus for this user
  2. Auth → Login as that user

  Response includes `products: ["MIS","CNC","NRML"]` and `product: "MIS"` (default).

  Live signals must include `"product"` when multiple are enabled — see Signals → ingest-indian-cnc.
  Non–Pro Plus plans receive 400 if more than one product is sent.
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("credId", res.getBody().data.id);
    bru.setVar("multiProductCredId", res.getBody().data.id);
  }
}

tests {
  test("Created multi-product credential", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().data;
    expect(data.products).to.be.an("array");
    expect(data.products).to.include.members(["MIS", "CNC", "NRML"]);
    expect(data.product).to.equal("MIS");
  });
}
