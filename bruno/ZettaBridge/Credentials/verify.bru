meta {
  name: POST Verify Credential
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/credentials/{{credId}}/verify
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Validates stored credential format (and pings broker equity when `BROKER_MODE=live`).

  **Success:** `{ valid: true, broker_type, account_mode?, exchange?, product? }`

  **Failure:** `{ valid: false, broker_type, error, error_code?, hint? }`
  - `error_code` — brokererr code when live probe fails (e.g. `auth_failed`, `broker_unreachable`)
  - `hint` — actionable refresh steps (e.g. re-PUT Kite access token, Angel JWT, Dhan token)
}

tests {
  test("Verify returns validation result", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data).to.have.property("valid");
    expect(data).to.have.property("broker_type");
    expect(data).to.not.have.property("raw_creds");
  });

  test("Valid credential reports exchange and product", function() {
    const data = res.getBody().data;
    if (data.valid === true) {
      expect(data.exchange).to.be.oneOf(["NSE", "BSE", ""]);
      if (data.broker_type !== "mt5_cloud") {
        expect(["NSE", "BSE"]).to.include(data.exchange);
      }
    }
  });

  test("Failed verify may include error_code and hint", function() {
    const data = res.getBody().data;
    if (data.valid === false && data.error_code) {
      expect(data.error_code).to.be.a("string");
      if (data.hint) {
        expect(data.hint).to.be.a("string");
      }
    }
  });
}
