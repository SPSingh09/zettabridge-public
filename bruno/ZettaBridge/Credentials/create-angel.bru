meta {
  name: POST Create Credential (angel)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "broker_type": "angel",
    "account_label": "Angel One",
    "account_mode": "live",
    "exchange": "NSE",
    "product": "MIS",
    "raw_creds": "api_key:client_code:jwt"
  }
}

docs {
  Angel SmartAPI format: `api_key:client_code:jwt`.
  Requires `exchange` (NSE|BSE) and `product` (MIS|CNC|NRML).

  **Live mode:** Angel egress IPs + SmartAPI JWT refresh — see `docs/broker-guide.md`.
  Symbol tokens cached in Redis (`symtoken:angel:…`). Webhook: **create-indian**.
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("angelCredId", res.getBody().data.id);
    bru.setVar("credId", res.getBody().data.id);
  }
}

tests {
  test("Angel credential created with exchange and product", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().data;
    expect(data.broker_type).to.equal("angel");
    expect(data.exchange).to.equal("NSE");
    expect(data.product).to.equal("MIS");
    expect(data).to.not.have.property("raw_creds");
  });
}
