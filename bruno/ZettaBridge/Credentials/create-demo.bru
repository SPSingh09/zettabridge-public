meta {
  name: POST Create Credential (demo — zerodha alias)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "broker_type": "zerodha",
    "account_label": "Zerodha Demo",
    "account_mode": "demo",
    "exchange": "NSE",
    "product": "MIS",
    "raw_creds": "api_key:access_token"
  }
}

docs {
  Alias of **create-zerodha** (same payload). Prefer create-zerodha for clarity.
  `raw_creds` is encrypted server-side before storage. Zerodha format: `api_key:access_token`.
  Indian brokers require `exchange` (NSE|BSE); `product` defaults to MIS.
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("credId", res.getBody().data.id);
    console.log("credId saved — run POST Verify Credential next");
  }
}

tests {
  test("Created credential returns metadata only", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().data;
    expect(data.id).to.be.a("string");
    expect(data.broker_type).to.equal("zerodha");
    expect(data.exchange).to.equal("NSE");
    expect(data.product).to.equal("MIS");
    expect(data).to.not.have.property("raw_creds");
    expect(data).to.not.have.property("encrypted_creds");
  });

  test("Response body omits ciphertext", function() {
    const body = JSON.stringify(res.getBody());
    expect(body).to.not.include("v1:");
    expect(body).to.not.include("api_key:api_secret");
  });
}
