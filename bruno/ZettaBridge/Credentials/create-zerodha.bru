meta {
  name: POST Create Credential (zerodha)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "broker_type": "zerodha",
    "account_label": "Zerodha Live",
    "account_mode": "live",
    "exchange": "NSE",
    "product": "MIS",
    "market_protection": 2,
    "raw_creds": "api_key:access_token"
  }
}

docs {
  **Zerodha Kite** — `raw_creds`: `api_key:access_token` (or `api_key:api_secret` before OAuth).

  Requires **pro** or **pro_plus** plan and `account_mode: live`.
  Indian brokers require `exchange` (NSE|BSE). Single `product` (default MIS).

  Pro Plus multi-product: use **create-multi-product-pro-plus** instead.

  Pair with Webhooks → **create-indian** — include `price` on LIMIT/MARKET signals.
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("credId", res.getBody().data.id);
    bru.setVar("zerodhaCredId", res.getBody().data.id);
    console.log("credId saved — run POST Verify Credential next");
  }
}

tests {
  test("Created credential returns metadata only", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().data;
    expect(data.id).to.be.a("string");
    expect(data.broker_type).to.equal("zerodha");
    expect(data.exchange).to.equal("NSE");
    expect(data.product).to.equal("MIS");
    expect(data.products).to.be.an("array");
    expect(data).to.not.have.property("raw_creds");
  });
}
