meta {
  name: POST Create Credential (zerodha publisher)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "broker_type": "zerodha",
    "execution_mode": "publisher",
    "account_label": "Kite Publisher",
    "account_mode": "live",
    "exchange": "NSE",
    "product": "MIS",
    "order_type": "LIMIT",
    "raw_creds": "{{publisherApiKey}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("credId", res.getBody().data.id);
    bru.setVar("zerodhaPublisherCredId", res.getBody().data.id);
    console.log("Publisher credential saved — attach to a webhook then fire a signal to create a publisher order.");
  }
}

tests {
  test("Created publisher credential returns metadata only", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().data;
    expect(data.id).to.be.a("string");
    expect(data.broker_type).to.equal("zerodha");
    expect(data.execution_mode).to.equal("publisher");
    expect(data.exchange).to.equal("NSE");
    expect(data.account_mode).to.equal("live");
    expect(data).to.not.have.property("raw_creds");
  });
}

docs {
  Creates a Zerodha Kite Publisher credential.

  **`execution_mode: "publisher"`** — no daily OAuth handshake needed. The credential only
  needs the API key (not api_key:access_token). The server stores it encrypted with AES-256-GCM.

  **`raw_creds`:** just the API key string (no colon, no access token).
  Set `publisherApiKey` in Bruno environment vars before running.

  **`account_mode: "live"`** is required — publisher mode only applies to live accounts.

  **After this call:**
  1. Attach the credential to a live Indian-market webhook.
  2. Fire a signal → worker creates a publisher order automatically.
  3. Fetch GET Publisher Order Status → POST handoff to Kite.

  **Verify is not needed** for publisher credentials — there is no OAuth token to validate.
  The credential is considered ready once created.
}
