meta {
  name: PUT Update Credential
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/v1/credentials/{{credId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "account_label": "Zerodha Live",
    "exchange": "NSE",
    "products": ["MIS", "CNC"]
  }
}

docs {
  Optional `raw_creds` rotates the stored secret (re-encrypted).
  Omit to update label/exchange/product(s) only.
  Pro Plus: use `products` array; other plans use single `product`.
}

tests {
  test("Updated credential returns metadata only", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data).to.not.have.property("raw_creds");
    expect(data).to.not.have.property("encrypted_creds");
    expect(data).to.have.property("exchange");
    expect(data).to.have.property("product");
    if (data.products) {
      expect(data.products).to.be.an("array");
    }
  });

  test("Response body omits ciphertext", function() {
    const body = JSON.stringify(res.getBody());
    expect(body).to.not.include("v1:");
    expect(body).to.not.include("new_key:new_secret");
  });
}
