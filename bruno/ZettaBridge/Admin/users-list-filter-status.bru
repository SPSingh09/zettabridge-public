meta {
  name: GET List Users — filter by status
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/admin/users?page=1&limit=50&status={{filterStatus}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

docs {
  Set {{filterStatus}} to active or suspended (collection vars).
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
