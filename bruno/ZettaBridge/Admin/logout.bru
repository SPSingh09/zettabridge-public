meta {
  name: POST Admin Logout
  type: http
  seq: 1.5
}

post {
  url: {{baseUrl}}/v1/auth/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setVar("adminToken", "");
    bru.setVar("token", "");
    console.log("admin logged out — adminToken and token cleared");
  }
}

docs {
  Prerequisite: Admin > POST Admin Login (sets {{adminToken}}).
  Revokes the current JWT server-side; clears {{adminToken}} and {{token}} on 204.
  After logout, admin endpoints return 401 token revoked.
}

tests {
  test("Status 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
