meta {
  name: GET List Orgs
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/v1/admin/orgs?page=1&limit=50
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const orgs = res.getBody().data?.orgs;
    if (Array.isArray(orgs) && orgs.length > 0) {
      bru.setVar("orgId", orgs[0].id);
    }
  }
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
