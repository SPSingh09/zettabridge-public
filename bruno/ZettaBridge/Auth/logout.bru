meta {
  name: POST Logout
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/auth/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setVar("token", "");
    console.log("logged out — token cleared");
  }
}

docs {
  Prerequisite: Auth > POST Login.
  Revokes the current JWT server-side; clears {{token}} on 204.
}

tests {
  test("Status 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
