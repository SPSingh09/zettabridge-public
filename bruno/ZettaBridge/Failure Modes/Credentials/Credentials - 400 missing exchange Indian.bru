meta {
  name: Credentials — 400 missing exchange (Indian)
  type: http
  seq: 38
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "broker_type": "zerodha",
    "account_label": "Missing Exchange",
    "raw_creds": "api_key:access_token"
  }
}

docs {
  Prerequisite: Auth > Login.
  Indian brokers (`zerodha`, `angel`, `dhan`) require `exchange` (NSE or BSE).
  Expected: 400 exchange is required
}

tests {
  test("Indian broker without exchange rejected", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("exchange");
  });
}
