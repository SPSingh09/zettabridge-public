meta {
  name: Credentials — 400 invalid raw_creds format
  type: http
  seq: 37
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "broker_type": "angel",
    "account_label": "Bad Angel Format",
    "exchange": "NSE",
    "raw_creds": "only:two_parts"
  }
}

docs {
  Prerequisite: Auth > Login.
  Angel requires `api_key:client_code:jwt` (3 colon-separated parts).
  Expected: 400 invalid raw_creds
}

tests {
  test("Invalid angel raw_creds rejected", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("invalid raw_creds");
    expect(res.getBody().error).to.include("api_key:client_code:jwt");
  });
}
