meta {
  name: Credential — 400 multi-product on non–Pro Plus
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "broker_type": "zerodha",
    "account_label": "Should fail",
    "account_mode": "live",
    "exchange": "NSE",
    "products": ["MIS", "CNC"],
    "raw_creds": "api_key:access_token"
  }
}

docs {
  Prerequisite: user on **pro** (or free/paper) — not pro_plus.
  Expected: 400 your plan allows one product per broker account...
}

tests {
  test("Multi-product rejected", function() {
    expect(res.getStatus()).to.equal(400);
  });
}
