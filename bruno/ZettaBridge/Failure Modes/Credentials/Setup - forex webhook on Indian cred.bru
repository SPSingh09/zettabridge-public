meta {
  name: Setup — forex webhook on Indian cred
  type: http
  seq: 36
}

post {
  url: {{baseUrl}}/v1/webhooks
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "label": "forex-on-indian-cred-setup",
    "broker_cred_id": "{{credId}}",
    "symbol": "EURUSD",
    "lot_size": 1,
    "max_risk_pct": 0
  }
}

docs {
  Prerequisite: Credentials → create-demo (zerodha, saves credId).
  Creates a webhook bound to an Indian broker credential with a forex symbol — used by
  **Signal — invalid_symbol Indian broker** failure test.
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("indianForexWebhookToken", res.getBody().data.token);
    bru.setVar("indianForexWebhookId", res.getBody().data.id);
  }
}

tests {
  test("Forex-on-Indian setup webhook created", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.token).to.be.a("string");
  });
}
