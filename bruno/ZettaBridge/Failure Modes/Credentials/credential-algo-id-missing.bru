meta {
  name: Credential — live Indian without algo_id
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "broker_type": "zerodha",
    "account_label": "Missing Algo ID",
    "account_mode": "live",
    "exchange": "NSE",
    "product": "MIS",
    "raw_creds": "api_key:access_token"
  }
}

docs {
  When SEBI_ALGO_ID_REQUIRED=true, live Indian credentials without algo_id (and no env fallback) return 400.
  Functional CI sets SEBI_ALGO_ID_REQUIRED=false — run against staging with enforcement enabled.
}

tests {
  test("Status is 400 or 403 depending on plan/enforcement", function() {
    expect([400, 403]).to.include(res.getStatus());
  });
}
