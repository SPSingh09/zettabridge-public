meta {
  name: Credentials — 400 empty raw_creds
  type: http
  seq: 36
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "broker_type": "zerodha",
    "account_label": "Missing Secret",
    "raw_creds": "   "
  }
}

docs {
  Prerequisite: Auth > Login. `raw_creds` is required on create.
  Expected: 400 raw_creds is required
}

tests {
  test("Empty raw_creds rejected", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("raw_creds");
  });
}
