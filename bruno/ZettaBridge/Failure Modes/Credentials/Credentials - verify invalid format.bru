meta {
  name: Credentials — verify invalid format (hint)
  type: http
  seq: 43
}

post {
  url: {{baseUrl}}/v1/credentials/{{badCredId}}/verify
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  **Setup:** Create angel credential with valid `raw_creds`, then use PUT to store invalid plaintext only if your test DB allows legacy blobs.
  In normal API flow, invalid `raw_creds` are rejected on POST/PUT (see Credentials — 400 invalid raw_creds format).

  When stored credentials fail parse, verify returns HTTP 200 with:
  `{ valid: false, error, hint: "Use raw_creds format api_key:client_code:jwt" }`

  Replace `{{badCredId}}` with a credential id known to have corrupt stored secrets (manual QA only).
}

tests {
  test("Verify returns valid flag", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data).to.have.property("valid");
    if (data.valid === false) {
      expect(data.error).to.be.a("string");
      if (data.hint) {
        expect(data.hint).to.include("raw_creds format");
      }
    }
  });
}
