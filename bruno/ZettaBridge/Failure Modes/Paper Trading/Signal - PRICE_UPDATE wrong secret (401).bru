meta {
  name: Signal - PRICE_UPDATE wrong secret (401)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/webhook/{{paperWebhookToken}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "comment": "not-the-right-secret",
    "type": "PRICE_UPDATE",
    "symbol": "SBIN",
    "price": 838
  }
}

docs {
  Prerequisite: Paper Trading → create-webhook (`paperWebhookToken` set, with
  `required_comment: "paper-secret-1"`).

  PRICE_UPDATE never touches the queue or the ORDER_SIGNAL/guard pipeline —
  it verifies `comment` against the webhook's `required_comment` directly
  (see internal/modules/signals/paper_ingest.go), so this exercises that
  check in isolation from ORDER_SIGNAL's guard.ValidateIngest path.
}

tests {
  test("Status 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
