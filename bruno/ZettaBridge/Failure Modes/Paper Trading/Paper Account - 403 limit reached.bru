meta {
  name: Paper Account - 403 limit reached
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/paper-accounts
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "label": "Second account (should fail)",
    "starting_balance": 50000
  }
}

docs {
  Prerequisite: Paper Trading → create-account already succeeded once for this
  user (the flat cap is 1 account per user, regardless of plan).
}

tests {
  test("Status 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
  test("Error mentions the limit", function() {
    expect(res.getBody().error).to.include("paper account limit reached");
  });
}
