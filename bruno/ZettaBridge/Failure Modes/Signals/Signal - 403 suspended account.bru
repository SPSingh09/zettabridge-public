meta {
  name: Signal — 403 suspended account
  type: http
  seq: 46
}

post {
  url: {{baseUrl}}/v1/webhook/{{webhookToken}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "action": "BUY",
    "symbol": "EURUSD",
    "lot": 0.01
  }
}

docs {
  Prerequisite: platform admin suspends the webhook owner's user account.
  Expected: 403 account suspended (webhook token alone is not enough when account is suspended).
}

tests {
  test("Suspended account rejected", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
