meta {
  name: Signal — missing product (multi-product cred)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/webhook/{{indianWebhookToken}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "action": "BUY",
    "symbol": "RELIANCE",
    "lot": 1,
    "price": 2500,
    "comment": "bruno_indian"
  }
}

docs {
  Prerequisite: multi-product credential (MIS+CNC+NRML) attached to webhook.

  Without `product`, the worker rejects the order async — credential requires product in signal.
  Check Webhooks → trades for rejection reason.
}

tests {
  test("Ingest accepted (async reject expected)", function() {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody().queued).to.equal(true);
  });
}
