meta {
  name: Org — 403 member create credential
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{inviteeToken}}
}

body:json {
  {
    "broker_type": "zerodha",
    "account_label": "Should Fail",
    "raw_creds": "key:secret:token"
  }
}

docs {
  Prerequisite: login as org member (not owner/admin).
  Expected: 403 insufficient org permissions
}

tests {
  test("Member blocked from credential create", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
