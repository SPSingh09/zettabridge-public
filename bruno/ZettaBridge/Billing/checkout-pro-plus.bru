meta {
  name: POST Checkout — Pro Plus
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/billing/checkout
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "plan": "pro_plus"
  }
}

docs {
  Starts Stripe Checkout for Pro Plus (3 live brokers, multi-product credentials).
  Requires BILLING_ENABLED=true and STRIPE_PRICE_PRO_PLUS configured.
}

tests {
  test("Checkout URL or disabled", function() {
    const status = res.getStatus();
    expect([200, 503]).to.include(status);
    if (status === 200) {
      expect(res.getBody().data.url).to.be.a("string");
    }
  });
}
