meta {
  name: PUT Pause Paper Account
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/v1/paper-accounts/{{paperAccountId}}/pause
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.status).to.equal("paused");
  });
}
