meta {
  name: PUT Update Webhook Guards (free plan, should succeed)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/v1/webhooks/{{paperWebhookId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "allowed_symbols": ["SBIN", "INFY", "TCS"],
    "dedup_window_sec": 30
  }
}

docs {
  Deliberately run this as a **free-plan** user. On a live-broker webhook, both
  `allowed_symbols` and `dedup_window_sec` are Individual+ features and this same
  request would 403 with "advanced webhook guards require a paid plan" on **live** webhooks only.
  Paper webhooks accept dedup regardless of plan.
  (see Failure Modes → Webhooks). On a **paper** webhook it must succeed — Paper
  Trading is a flat, plan-independent tier, so none of its guard config is gated.

  Prerequisite: Paper Trading → create-webhook (`paperWebhookId` set), and the
  logged-in user must be on the free plan (no admin plan upgrade applied).
}

tests {
  test("Status 200 (not 403)", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Guards applied", function() {
    const data = res.getBody().data;
    expect(data.allowed_symbols).to.include("SBIN");
    expect(data.allowed_symbols).to.include("INFY");
    expect(data.dedup_window_sec).to.equal(30);
  });
}
