meta {
  name: GET Me — Free plan limits
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Verify free-plan limits on /v1/me.

  Expected:
  - plan: "free"
  - max_paper_accounts: 1
  - max_paper_webhooks: 1
  - max_live_webhooks: 0
  - max_broker_creds: 0
  - max_webhooks: 1
  - live_trading_allowed: false
  - max_paper_trades_per_month: 10
  - orders_per_sec_enforced: 1

  Free users can paper trade but cannot create live broker credentials.
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Plan is free", function() {
    expect(res.getBody().data.plan).to.equal("free");
  });
  test("Free tier limits", function() {
    const d = res.getBody().data;
    expect(d.max_paper_accounts).to.equal(1);
    expect(d.max_paper_webhooks).to.equal(1);
    expect(d.max_live_webhooks).to.equal(0);
    expect(d.max_broker_creds).to.equal(0);
    expect(d.max_webhooks).to.equal(1);
    expect(d.live_trading_allowed).to.equal(false);
    expect(d.max_paper_trades_per_month).to.equal(10);
    expect(d.orders_per_sec_enforced).to.equal(1);
    expect(d.broker_cred_orders_per_sec).to.equal(10);
  });
}
