# AWS ECS staging credentials and URLs (copy to staging-aws.env — gitignored).
#
#   cp deploy/deploy-aws-ecs/staging-aws.env.example deploy/deploy-aws-ecs/staging-aws.env
#
# Used by: deploy-staging-full.sh, aws-deploy.sh, staging-smoke.sh

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
IMAGE_TAG=staging
ECS_CLUSTER=zettabridge-staging
ECS_SERVICE_BACKEND=zettabridge-staging
ECS_SERVICE_DASHBOARD=zettabridge-staging-dashboard

# Optional: override adapter ECS services (comma-separated). Default: from terraform output.
# ECS_ADAPTER_SERVICES=zettabridge-staging-zerodha-adapter

# ── Staging URLs (optional — auto-read from terraform output api_url) ─────────
STAGING_BASE_URL=https://api.staging.zettabridge.net
# STAGING_ZERODHA_ADAPTER_URL=https://exec-zerodha.staging.zettabridge.net

# ── Smoke test admin (required for aws-deploy.sh smoke) ───────────────────────
STAGING_ADMIN_EMAIL=admin@zettabridge.net
STAGING_ADMIN_PASSWORD=change-me

# Optional smoke / functional flags:
# STAGING_REGISTER_ADMIN=1
# STAGING_SKIP_ADMIN=1
# STAGING_INSECURE=1
# STAGING_METRICS_TOKEN=          same as ECS METRICS_TOKEN (for functional /metrics assert)
