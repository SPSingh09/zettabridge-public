# Copy to deploy/loadtest/env.local (never commit secrets):
#   cp deploy/loadtest/env.example deploy/loadtest/env.local
#
# Or auto-generate with setup (recommended):
#   ./deploy/loadtest/setup-loadtest-webhook.sh
#
# Then run:
#   ./deploy/loadtest/run-loadtest.sh smoke
#   ./deploy/loadtest/run-loadtest.sh target

# AWS staging API base (no trailing slash) — optional if staging-aws.env or terraform output is set
LOADTEST_BASE_URL=https://api.staging.zettabridge.net

# From setup-loadtest-webhook.sh:
LOADTEST_WEBHOOK_TOKEN=
LOADTEST_DEDUP_WEBHOOK_TOKEN=
LOADTEST_RL_FREE_TOKEN=
LOADTEST_RL_PAID_TOKEN=
LOADTEST_BRACKET_WEBHOOK_TOKEN=
LOADTEST_SYMBOL=RELIANCE

# Scenario overrides (run-loadtest.sh sets defaults per scenario)
# LOADTEST_VUS=10
# LOADTEST_DURATION=1m

# k6 results directory (default deploy/loadtest/results)
# LOADTEST_RESULTS_DIR=
