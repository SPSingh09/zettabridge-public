# GHCR pull credentials — copy to /opt/zettabridge/env/ghcr.env (never commit)
# chmod 600 /opt/zettabridge/env/ghcr.env
#
# Create a GitHub fine-grained PAT:
#   GitHub → Settings → Developer settings → Fine-grained tokens
#   Repository access: zettabridge only
#   Permissions: Packages → Read-only
#
# Images are all lowercase (GHCR requirement — use lowercase GitHub username):
#   main branch CI    → ghcr.io/spsingh09/zettabridge:staging
#                       ghcr.io/spsingh09/zettabridge-dashboard:staging
#   develop branch CI → :develop variants
#
# While testing on develop before merge, point the VM at :develop; after merge to
# main, switch back to :staging (main push rebuilds that tag).

GHCR_USER=your-github-username
GHCR_TOKEN=

# main branch build (use on VM after merging to main):
ZETTABRIDGE_IMAGE=ghcr.io/spsingh09/zettabridge:staging
ZETTABRIDGE_DASHBOARD_IMAGE=ghcr.io/spsingh09/zettabridge-dashboard:staging

# develop branch build (use on VM to test before merging):
# ZETTABRIDGE_IMAGE=ghcr.io/spsingh09/zettabridge:develop
# ZETTABRIDGE_DASHBOARD_IMAGE=ghcr.io/spsingh09/zettabridge-dashboard:develop
