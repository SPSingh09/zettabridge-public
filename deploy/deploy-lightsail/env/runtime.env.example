# ZettaBridge runtime environment contract
#
# Copy to a private file (never commit secrets):
#   deploy/env/oci.staging.env   — OCI VM
#   deploy/env/aws.staging.env   — reference for Terraform / ECS
#
# Validate before deploy:
#   ./deploy/scripts/check-env.sh deploy/env/oci.staging.env
#
# Full plan: docs/plans/pluggable-deployment.md

# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=staging
PORT=8080

# ── Data plane (hosts differ by platform; names do not) ───────────────────────
DATABASE_URL=postgres://USER:PASS@HOST:5432/zettabridge?sslmode=require
REDIS_URL=redis://HOST:6379

# ── Security (generate once; reuse across OCI→AWS migration) ──────────────────
# openssl rand -base64 48
JWT_SECRET=

# openssl rand -hex 32
AES_KEY=

# optional — scraper bearer token for GET /metrics
METRICS_TOKEN=

# ── Public URLs ─────────────────────────────────────────────────────────────
APP_PUBLIC_URL=https://api.staging.example.com
CORS_ORIGINS=https://app.staging.example.com

# ── Workers ─────────────────────────────────────────────────────────────────
WORKER_COUNT=20
QUEUE_BUFFER=500

# ── Brokers ─────────────────────────────────────────────────────────────────
# "mock" = paper trading only. "live" = real broker APIs.
# Before setting to "live": whitelist server IP with Angel and Dhan developer portals first.
# Lightsail VM: 52.66.136.127  |  AWS (ECS): NAT Elastic IP (see 5A.4)
BROKER_MODE=mock
BROKER_HTTP_TIMEOUT_SEC=8
BROKER_HTTP_GET_RETRIES=2

# Required when BROKER_MODE=live — set to server's outbound public IP.
# Lightsail example: BROKER_ANGEL_CLIENT_LOCAL_IP=52.66.136.127
# AWS example: use NAT Elastic IP from 5A.4
# Get VM MAC: cat /sys/class/net/eth0/address
BROKER_ANGEL_CLIENT_LOCAL_IP=
BROKER_ANGEL_CLIENT_PUBLIC_IP=
BROKER_ANGEL_MAC_ADDRESS=00:00:00:00:00:00

# Optional platform-wide algo ID fallbacks (see docs/plans/sebi-algo-id.md)
# BROKER_ZERODHA_ALGO_ID=
# BROKER_ANGEL_ALGO_ID=
# BROKER_DHAN_ALGO_ID=

# ── Email verification ────────────────────────────────────────────────────────
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@staging.example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── Compliance / gating ─────────────────────────────────────────────────────
# SEBI_ALGO_ID_REQUIRED is auto-enforced to true when BROKER_MODE=live.
# Only set explicitly to false on staging where BROKER_MODE=mock.
SEBI_ALGO_ID_REQUIRED=false

# ── Observability ─────────────────────────────────────────────────────────────
METRICS_ENABLED=true

# ── Optional bootstrap (remove after first admin exists) ─────────────────────
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ── Optional early bird ───────────────────────────────────────────────────────
# EARLY_BIRD_LIVE_ENABLED=true
# EARLY_BIRD_LIVE_ORDER_LIMIT=10

# ── Stripe billing (PR 4B.1) ──────────────────────────────────────────────────
# BILLING_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ENTERPRISE_STARTER=
# STRIPE_PRICE_ENTERPRISE_TEAM=
# STRIPE_PRICE_ENTERPRISE_BUSINESS=
# Defaults when unset:
#   BILLING_SUCCESS_URL=${APP_PUBLIC_URL}/billing/success?session_id={CHECKOUT_SESSION_ID}
#   BILLING_CANCEL_URL=${APP_PUBLIC_URL}/billing/cancel
#   BILLING_PORTAL_RETURN_URL=${APP_PUBLIC_URL}/billing/cancel
# Product policy (code constants): enterprise_before_org=true, cancel_immediate=true
