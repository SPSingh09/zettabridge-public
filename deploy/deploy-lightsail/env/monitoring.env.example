# Monitoring stack — copy to a private file (never commit secrets):
#   /opt/zettabridge/env/monitoring.env   (Lightsail VM)
#   deploy/env/monitoring.env             (local dev)
#
# Start: ./deploy/scripts/monitoring-up.sh

# ── Environment labels (Alertmanager routing) ───────────────────────────────
OBS_ENVIRONMENT=staging
OBS_CLUSTER=lightsail-mumbai
OBS_ALERTS_FILE=zettabridge-staging.yml

# Prometheus scrape target (Lightsail / local)
# - Lightsail VM (127.0.0.1:8080 bind): leave default — monitoring-up.sh auto-uses server:8080
# - Local dev (docker compose 8080:8080 on host): host.docker.internal:8080 works
ZETTABRIDGE_SCRAPE_TARGET=host.docker.internal:8080

# AWS staging scrape (optional — uncomment to also scrape the ECS backend over HTTPS)
# monitoring-up.sh appends a second Prometheus job when this is set.
# No extra AWS infra needed — Lightsail Prometheus reaches the public ALB endpoint.
# AWS_STAGING_SCRAPE_HOST=api.staging.zettabridge.net
# AWS_STAGING_METRICS_TOKEN=   # only needed if METRICS_TOKEN is set on the ECS server

# ── Telegram (optional — skip if blocked/unavailable; Grafana still works) ───
# Leave empty to run Grafana + Prometheus only (alerts logged, not delivered).
TELEGRAM_BOT_TOKEN=
# Staging alerts chat — functional tests / smoke noise goes here
TELEGRAM_STAGING_CHAT_ID=
# Oncall chat — production only (can duplicate staging ID until prod exists)
TELEGRAM_ONCALL_CHAT_ID=

# ── Grafana (localhost:3001 via SSH tunnel only) ─────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Optional: render output directory (default /opt/zettabridge/monitoring/rendered)
# MONITORING_RENDER_DIR=/opt/zettabridge/monitoring/rendered

# Optional: when METRICS_TOKEN is set on the server
# PROMETHEUS_BEARER_TOKEN=
